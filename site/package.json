{
  "name": "soulscrape-site",
  "version": "0.4.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:theme": "bun scripts/check-paper-theme.mjs",
    "sync:readme": "bun scripts/sync-readme.ts",
    "dev": "bun run sync:readme && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "bun test ./tests/source.test.ts ./tests/home.test.tsx ./tests/layout.test.tsx ./tests/ui-styles.test.tsx ./tests/markdown.test.tsx ./tests/profile-view.test.ts ./tests/corpus-graph.test.ts ./tests/graph-api.test.ts ./tests/corpus-api.test.ts ./tests/openapi-api.test.ts ./tests/device-lifecycle.test.ts ./tests/api-body.test.ts ./tests/people-api.test.ts ./tests/dossier-view.test.tsx ./tests/profile-links.test.tsx ./tests/device-auth-api.test.ts ./tests/public-response.test.ts ./tests/profile-storage.test.ts ./tests/related-profiles.test.ts ./tests/portrait-coverage.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project convex",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "check": "bun run check:theme && bun run sync:readme && bun run test && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.4.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.13.0",
    "@hraness/suite-accounts": "github:hraness/suite-accounts#v0.9.7",
    "@hraness/ui": "github:hraness/ui#v0.4.10",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "convex": "1.44.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.28",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
